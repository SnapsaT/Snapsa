# ─────────────────────────────────────────────────────────────────────────────
# SnapServer — Environment Variables
# Place this file at: WernTjat-BackEnd/snapserver/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
SNAP_PORT=4040
NODE_ENV=development

# ── SAME MongoDB as WernTjat — shared database, no second cluster ─────────────
SNAP_MONGO_URI=mongodb+srv://werndtz:Werndtz%40MANGOOSE07@werntjatdb.0fsrfzi.mongodb.net/WernTjatDB?retryWrites=true&w=majority&appName=WernTjat

# ── SAME JWT secret as WernTjat main server — tokens are cross-compatible ─────
SNAP_JWT_SECRET=ca2eabcb354fca686d90f338ffeb0dc6b22921d6c768c4e65f29bfcf7ebbad3dbdd995fdce1d04a2a5b5b4c9bf2e70b46673c438b149e6ee365074996e3067fd

# ── CORS — allow WernTjat frontend to call SnapServer ─────────────────────────
SNAP_ORIGIN=http://localhost:5173

# ── Upload directory (local disk) ─────────────────────────────────────────────
# Files saved here are served at http://localhost:4040/snapsa/media/...
SNAP_UPLOAD_DIR=./uploads/snapsa

# ── Video size cap (MB) ───────────────────────────────────────────────────────
SNAP_MAX_VIDEO_MB=500

# ── Cloudinary (same account as WernTjat — for cloud video storage) ──────────
# Used when SNAP_USE_CLOUDINARY=true to store watermarked videos in the cloud
# instead of local disk. Leave false for local dev.
SNAP_USE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=df7rvr2nz
CLOUDINARY_API_KEY=789282463521277
CLOUDINARY_API_SECRET=EjEeAO-MYakifEShYnhRJm-5SQo

# ── Redis (same instance as WernTjat — for live viewer pub/sub in multi-node) ─
# Only needed when you run SnapServer on more than one process/dyno.
SNAP_REDIS_URL=redis://default:lvsi30TMkJaUvSr8Pp6X79Gdtk6xyXZT@redis-18088.c341.af-south-1-1.ec2.cloud.redislabs.com:18088
SNAP_USE_REDIS=false

# ── Security ──────────────────────────────────────────────────────────────────
SNAP_RATE_LIMIT_DISABLED=false

# ── AWS IVS (live streaming) — same keys as WernTjat main server ─────────────
AWS_ACCESS_KEY_ID=AKIA...your key here...
AWS_SECRET_ACCESS_KEY=your secret here
AWS_REGION=us-east-1
